# Copy to .env.local for local development. On Cloudflare, set these as
# "Build variables" (the NEXT_PUBLIC_* ones are baked into the build) —
# see docs/NEW-SITE-CHECKLIST.md.

# ── Per site (required) ────────────────────────────────────────────────────
# Final public address, no trailing slash. Used for canonical URLs, sitemaps and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From sanity.io/manage → your project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Cloudflare deploy (set in Cloudflare, not needed locally) ──────────────
# Name of this site's Worker, e.g. cozy-desk. Lowercase letters, numbers, hyphens.
CF_WORKER_NAME=
# Optional custom domain without https://, e.g. cozydesk.com (adds apex + www)
CF_ROUTE=

# ── Secret, set as a Worker secret (Variables and Secrets), never in git ───
# Must equal the secret you typed into the Sanity webhook.
SANITY_WEBHOOK_SECRET=

# ── Local only: for `npm run seed` and `npm run bulk-import` ───────────────
# Sanity → API → Tokens → Add token → role "Editor". Keep it on your computer.
SANITY_WRITE_TOKEN=
